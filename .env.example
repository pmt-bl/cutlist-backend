# Copy this file to .env and fill in real values. Never commit the real .env file.

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cutlist"

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
